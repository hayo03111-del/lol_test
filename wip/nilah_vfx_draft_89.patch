   }
 };
 
+/* ===== src/champions/nilah_vfx_v3.js ===== */
+/* nilah_vfx_v3.js — 89차: 닐라 이펙트 전면 교체
+ * 사용자가 올려 준 닐라 원작 이펙트 텍스처(assets/nilah/*.png, 게임 파일에서 뽑은 그림 그대로)만으로 평타·치명타·Q·W(회피)·E·R·
+ * 패시브 보호막을 다시 그린다. 예전 두 체계(vfx.spawn('nilah*'), nilahVfx2의 색 고리)는 닐라 코드에서 더 이상 부르지 않는다.
+ * 원작 파티클 정의(.bin)는 받지 못해서 크기·시간·움직임은 원작 연출(물 채찍 직선, 물안개 베일, 물 회오리 고리)을 보고 맞춘 값이고,
+ * 크기는 전부 실제 판정 수치(LoL 단위 → lolRangeToWorld)에 맞춘다.
+ */
+const NILAH_FX_FILES = {
+  baSwipe1: 'nilah_base_ba_swipe_01.png', baSwipe2: 'nilah_base_ba_swipe_02.png',
+  baSplash: 'nilah_base_ba_linearsplashes_02.png', baSplashDis: 'nilah_base_ba_linearsplashes_02_dissolve.png',
+  baCritFlare: 'nilah_base_ba_crit_flare.png', baCritTar: 'nilah_base_ba_crit_tar.png',
+  qWater: 'nilah_base_q_water.png', qBeam: 'nilah_base_q_beam_mult.png', qCasGlow: 'nilah_base_q_cas_glow.png',
+  qSwipe: 'nilah_base_q_swipe.png', qSwipe1: 'nilah_base_q_swipe1.png', qSwipe2: 'nilah_base_q_swipe2.png',
+  qGroundLight: 'nilah_base_q_groundlight_01.png', qBloodTar: 'nilah_base_q_blood_tar.png', qMissBubbles: 'nilah_base_q_missbubbles.png',
+  wHalo: 'nilah_base_w_halo_1.png', wThreads: 'nilah_base_w_waterthreads_2x2.png', wWisps: 'nilah_base_w_wisps.png',
+  wSparkle: 'nilah_base_w_sparkle.png', wSparks: 'nilah_base_w_sparks.png', wSand: 'nilah_base_w_sand_smoke.png', wAuraFlames: 'nilah_base_w_aura_flames.png',
+  eRing: 'nilah_base_e_dash_ring.png', eWake: 'nilah_base_e_dash_wake_ground.png', eWake2: 'nilah_base_e_dash_wake_ground_02.png',
+  eCrescent: 'nilah_base_e_watercrescent_2x2.png', eTarSplash: 'nilah_base_e_dash_tar_splash.png', eTonado: 'nilah_base_e_tonado.png',
+  waterStreak: 'nilah_base_water_streak_flat.png',
+  rSwirl: 'nilah_base_r_cascircle_swirl_scroll_dark_mask.png', rSwordTrail: 'nilah_base_r_sword_trail2.png', rSwipeMult: 'nilah_base_r_swipe_mult.png',
+  rGlow: 'nilah_base_r_glow.png', rSplashRing: 'nilah_base_r_splash_ring.png', rFlash: 'nilah_base_r_flash.png', rTrail: 'nilah_base_r_trail.png',
+  rConeHit: 'nilah_base_r_cone_hit.png', blastRing: 'nilah_base_blastring.png', ringMult: 'base_ringmult_moresolid.png', splash2x2: 'nilah_base_splash_2x2.png',
+  auraSelf: 'aura_self.png', rainbow: 'nilah_base_rainbow.png', rStreaks: 'nilah_base_r_energystreaksadd.png', rNebula: 'nilah_base_r_einstein_01_mult.png',
+  rRingMult: 'nilah_base_r_ringmult.png', rSoft: 'nilah_base_r_softcircle.png', droplet: 'nilah_base_droplet_rotate_mult.png',
+};
+const NILAH_FX_TEX = {};
+const _nilahFxLoader = new THREE.TextureLoader();
+_nilahFxLoader.crossOrigin = undefined; // 로컬 파일(file://)에서도 열리게(nilah_vfx_v2와 같은 이유)
+for (const [key, file] of Object.entries(NILAH_FX_FILES)) {
+  const t = _nilahFxLoader.load('assets/nilah/' + file, undefined, undefined, (err) => console.warn('[NILAH FX] 텍스처 로드 실패:', file, err));
+  t.colorSpace = THREE.SRGBColorSpace;
+  NILAH_FX_TEX[key] = t;
+}
+// 강화 평타 부채꼴 바탕: 원작 영상처럼 안쪽은 옅고 바깥 테두리로 갈수록 진해지며 양옆은 부드럽게 사라지는 그라데이션(텍스처 묶음에 이 모양 그림이 없어 직접 만든다).
+NILAH_FX_TEX.fanGrad = (() => {
+  const W = 64, H = 64, cv = document.createElement('canvas'); cv.width = W; cv.height = H; const g = cv.getContext('2d'), img = g.createImageData(W, H);
+  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
+    const v = 1 - y / (H - 1), u = x / (W - 1), side = Math.min(1, Math.min(u, 1 - u) / 0.18), radial = 0.12 + 0.88 * Math.pow(v, 2.2);
+    const i = (y * W + x) * 4; img.data[i] = img.data[i + 1] = img.data[i + 2] = 255; img.data[i + 3] = Math.round(255 * side * radial);
+  }
+  g.putImageData(img, 0, 0); const t = new THREE.CanvasTexture(cv); t.colorSpace = THREE.SRGBColorSpace; return t;
+})();
+const NILAH_FX_CHEST = 0.55 * BASE_UNIT; // 몸통 높이(다른 닐라 코드의 BASE_UNIT*0.5와 같은 기준)
+
+function _nilahFxMat(key, opts = {}) {
+  let map = NILAH_FX_TEX[key];
+  if (opts.frame != null || opts.uvRotate) {
+    map = map.clone(); map.userData = { nilahFxClone: true }; map.needsUpdate = true;
+    if (opts.frame != null) { const g = opts.grid || 2; map.repeat.set(1 / g, 1 / g); map.offset.set((opts.frame % g) / g, 1 - (Math.floor(opts.frame / g) + 1) / g); }
+  }
+  return new THREE.MeshBasicMaterial({
+    map, color: opts.color ?? 0xffffff, transparent: true, opacity: opts.opacity ?? 1, depthWrite: false, side: THREE.DoubleSide,
+    blending: opts.blend === 'normal' ? THREE.NormalBlending : THREE.AdditiveBlending, toneMapped: false,
+  });
+}
+function _nilahFxSpriteMat(key, opts = {}) {
+  let map = NILAH_FX_TEX[key];
+  if (opts.frame != null) { const g = opts.grid || 2; map = map.clone(); map.userData = { nilahFxClone: true }; map.needsUpdate = true; map.repeat.set(1 / g, 1 / g); map.offset.set((opts.frame % g) / g, 1 - (Math.floor(opts.frame / g) + 1) / g); }
+  return new THREE.SpriteMaterial({ map, color: opts.color ?? 0xffffff, transparent: true, opacity: opts.opacity ?? 1, depthWrite: false,
+    blending: opts.blend === 'normal' ? THREE.NormalBlending : THREE.AdditiveBlending, rotation: opts.rotation || 0, toneMapped: false });
+}
+// 바닥에 눕힌 정사각/직사각 판(중심 기준).
+function _nilahFxGroundQuad(key, w, h, opts) {
+  const g = new THREE.PlaneGeometry(w, h); g.rotateX(-Math.PI / 2);
+  return new THREE.Mesh(g, _nilahFxMat(key, opts));
+}
+// 원점에서 +X로 len만큼 뻗는 띠(바닥과 평행). alongV면 텍스처의 세로축을 길이 방향으로 쓴다(세로로 긴 그림용).
+function _nilahFxLineQuad(key, len, w, opts = {}) {
+  const g = new THREE.PlaneGeometry(1, 1); g.translate(0.5, 0, 0); g.rotateX(-Math.PI / 2);
+  if (opts.alongV) { // 기본 UV(u=x, v=y)를 돌려 길이(x) 방향이 v가 되게
+    const uv = g.attributes.uv, pos = g.attributes.position;
+    for (let i = 0; i < uv.count; i++) { const x = pos.getX(i), z = pos.getZ(i); uv.setXY(i, 0.5 - z, x); }
+    uv.needsUpdate = true;
+  }
+  const m = new THREE.Mesh(g, _nilahFxMat(key, opts));
+  m.scale.set(len, 1, w);
+  return m;
+}
+// 바닥과 평행한 고리(u = 둘레 방향 반복, v = 안→밖).
+function _nilahFxRing(key, inner, outer, opts = {}) {
+  const segs = opts.segs || 64, rep = opts.uRepeat || 1;
+  const pos = [], uv = [], idx = [];
+  for (let i = 0; i <= segs; i++) {
+    const a = i / segs * Math.PI * 2, c = Math.cos(a), s = Math.sin(a);
+    pos.push(c * inner, 0, s * inner, c * outer, 0, s * outer);
+    const u = i / segs * rep; uv.push(u, 0, u, 1);
+    if (i < segs) { const k = i * 2; idx.push(k, k + 1, k + 2, k + 1, k + 3, k + 2); }
+  }
+  const g = new THREE.BufferGeometry();
+  g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
+  g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
+  g.setIndex(idx);
+  return new THREE.Mesh(g, _nilahFxMat(key, opts));
+}
+
+// 바닥과 평행한 부채꼴(중심 각 0, 반각 half; u = 각도 방향, v = 안→밖). 강화 평타 휩쓸기·R 채찍 궤적용.
+function _nilahFxSector(key, inner, outer, half, opts = {}) {
+  const segs = opts.segs || 32, pos = [], uv = [], idx = [];
+  for (let i = 0; i <= segs; i++) {
+    const a = -half + (2 * half) * i / segs, c = Math.cos(a), s = Math.sin(a);
+    pos.push(c * inner, 0, -s * inner, c * outer, 0, -s * outer); // +X가 가운데, 각도는 위에서 봐서 반시계(+)
+    const u = i / segs; uv.push(u, 0, u, 1);
+    if (i < segs) { const k = i * 2; idx.push(k, k + 1, k + 2, k + 1, k + 3, k + 2); }
+  }
+  const g = new THREE.BufferGeometry();
+  g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
+  g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
+  g.setIndex(idx);
+  const m = new THREE.Mesh(g, _nilahFxMat(key, opts));
+  return m;
+}
+// 가장자리가 밝은(프레넬) 물방울 막 - W 장막·R 원반에 쓴다. map의 R 채널로 물결 무늬를 흘린다.
+function _nilahFxFresnelMat(key, inner, rim, opts = {}) {
+  const map = NILAH_FX_TEX[key].clone(); map.userData = { nilahFxClone: true }; map.needsUpdate = true; map.wrapS = map.wrapT = THREE.RepeatWrapping;
+  return new THREE.ShaderMaterial({
+    uniforms: { map: { value: map }, inner: { value: new THREE.Color(inner) }, rim: { value: new THREE.Color(rim) }, opacity: { value: opts.opacity ?? 1 }, time: { value: 0 }, power: { value: opts.power ?? 2.0 } },
+    vertexShader: 'varying vec3 vN; varying vec3 vV; varying vec2 vUv; void main(){ vUv = uv; vec4 mv = modelViewMatrix * vec4(position,1.0); vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz); gl_Position = projectionMatrix * mv; }',
+    fragmentShader: 'uniform sampler2D map; uniform vec3 inner; uniform vec3 rim; uniform float opacity; uniform float time; uniform float power; varying vec3 vN; varying vec3 vV; varying vec2 vUv;' +
+      'void main(){ float f = pow(1.0 - abs(dot(normalize(vN), normalize(vV))), power); float t = texture2D(map, vUv * vec2(2.0, 1.0) + vec2(time * 0.35, time * 0.1)).r; float t2 = texture2D(map, vUv * vec2(3.0, 1.5) - vec2(time * 0.5, 0.0)).r;' +
+      ' vec3 col = mix(inner, rim, clamp(f + t * 0.35, 0.0, 1.0)) * (0.55 + 0.45 * max(t, t2)); float a = opacity * clamp(0.18 + f * 0.95 + t2 * 0.2, 0.0, 1.0); gl_FragColor = vec4(col * a, a); }',
+    transparent: true, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending,
+  });
+}
+// 몸에 덧입히는 빛(W 무지갯빛, R 푸른빛): 원래 스킨 메시와 같은 뼈대를 쓰는 덧칠 메시를 붙였다가 끝나면 뗀다.
+function _nilahFxBodyOverlay(unit, key, color, opacity) {
+  const list = [];
+  if (!unit || !unit.model) return list;
+  const map = NILAH_FX_TEX[key].clone(); map.userData = { nilahFxClone: true }; map.needsUpdate = true; map.wrapS = map.wrapT = THREE.RepeatWrapping;
