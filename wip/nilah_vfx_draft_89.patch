diff --git a/tools/e2e_glb/nilah_vfx_check.js b/tools/e2e_glb/nilah_vfx_check.js
new file mode 100644
index 0000000..91acc7c
--- /dev/null
+++ b/tools/e2e_glb/nilah_vfx_check.js
@@ -0,0 +1,58 @@
+// 89차 닐라 이펙트 점검(헤드리스 Chromium + 저장소 모델): 평타·치명타·Q(적중/빗나감)·Q 강화 평타·W(회피)·E·E 중 Q·R을 차례로 쓰고
+// 정해진 순간마다 스크린샷을 찍는다. 텍스처 로드 실패·콘솔 오류·효과가 끝난 뒤 남은 개수(새는지)를 함께 보고한다.
+// 사용법: THREE_DIR=<three package> [E2E_HIDE_MAP=1] node tools/e2e_glb/nilah_vfx_check.js <스크린샷 폴더>
+const { chromium } = require(process.env.PLAYWRIGHT || 'playwright');
+const startServer = require('./server.js');
+(async () => {
+  const shotDir = process.argv[2];
+  const srv = await startServer(); const port = srv.address().port;
+  const browser = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium', headless: true, args: ['--use-gl=swiftshader', '--enable-unsafe-swiftshader', '--disable-gpu-vsync', '--disable-frame-rate-limit'] });
+  const page = await browser.newPage({ viewport: { width: 900, height: 600 } });
+  const errors = [], texFail = [];
+  page.on('pageerror', (e) => errors.push(e.message.slice(0, 200)));
+  page.on('console', (m) => { const t = m.text(); if (/NILAH FX/.test(t)) texFail.push(t.slice(0, 160)); });
+  await page.goto(`http://127.0.0.1:${port}/index.html`, { waitUntil: 'load' });
+  await page.waitForFunction(() => window.__e2e, null, { timeout: 60000 });
+  await page.evaluate(() => { const s = document.getElementById('libraryChampSelect'); s.value = 'nilah'; s.dispatchEvent(new Event('change')); });
+  await page.waitForFunction(() => window.controller && window.controller.championId === 'nilah', null, { timeout: 60000 });
+  await page.waitForTimeout(1500);
+  const reset = () => page.evaluate(() => {
+    const E = window.__e2e, c = window.controller, L = E.lolRangeToWorld;
+    c._clearActionTimers(); c.currentActionKey = null; c.currentPhase = null; c.targetPos = null; c.currentTarget = null; c._attackReadyAt = 0;
+    c.cooldowns = { Q: 0, W: 0, E: 0, R: 0 }; c.mp = c.maxMp; c.hp = c.maxHp; c.statusEffects = [];
+    if (c._nilah) { c._nilah.eCharges = 2; c._nilah.rSeq = null; }
+    c.skillLevels = { Q: 5, W: 5, E: 5, R: 3 };
+    c.root.position.set(0, 0, 0); c.setState('IDLE'); c._returnToLocomotion();
+    const [d0, d1, d2] = E.dummies; for (const d of [d0, d1, d2]) { d.hp = d.maxHp = 1e5; d.statusEffects = []; }
+    d0.mesh.position.set(0, 0, -L(200)); d1.mesh.position.set(L(150), 0, -L(380)); d2.mesh.position.set(-L(250), 0, -L(260));
+  });
+  const shots = [];
+  const shot = async (name) => { const f = `${shotDir}/nilah_${name}.png`; await page.screenshot({ path: f, clip: { x: 150, y: 60, width: 600, height: 400 } }); shots.push(f); };
+  // 헤드리스는 느려서 0.2~0.5초짜리 효과가 스크린샷 사이에 끝난다 - 효과만 느리게(SLOW배) 재생하고, 효과 함수가 불린 직후부터 찍는다.
+  const SLOW = Number(process.env.NILAH_FX_SLOW || 0.12);
+  await page.evaluate((slow) => { const f = window.__e2e.nilahFx3; f.timeScale = slow; window.__fxCalls = []; for (const k of ['basicAttack', 'qCast', 'wStart', 'wDodge', 'eDash', 'rStart', 'rTick', 'rFinal']) { const o = f[k].bind(f); f[k] = (...a) => { if (window.__fxClearOn === k) { for (const it of f.items) it.kill = true; f.timeScale = slow; } window.__fxCalls.push(k); return o(...a); }; } }, SLOW);
+  const onCall = async (name, fn, method, shotsAt, clearOn = null) => {
+    await reset(); await page.waitForTimeout(300); await page.evaluate((c) => { window.__fxCalls = []; window.__fxClearOn = c; if (c) window.__e2e.nilahFx3.timeScale = 1; }, clearOn);
+    await page.evaluate(fn);
+    await page.waitForFunction((m) => window.__fxCalls.includes(m), method, { timeout: 15000 }).catch(() => {});
+    const t0 = Date.now();
+    for (const sec of shotsAt) { const ms = sec / SLOW * 1000 - (Date.now() - t0); if (ms > 0) await page.waitForTimeout(ms); await shot(`${name}_${sec}`); }
+    await page.evaluate((slow) => { const f = window.__e2e.nilahFx3; for (const it of f.items) it.kill = true; f.timeScale = slow; window.__fxClearOn = null; }, SLOW);
+    await page.waitForTimeout(300);
+  };
+  const T0 = 'window.__e2e.getWorldPosition(window.__e2e.dummies[0]).clone()';
+  await onCall('aa', `window.controller.selectTarget(window.__e2e.dummies[0])`, 'basicAttack', [0.05, 0.15]);
+  await onCall('crit', `(() => { const c = window.controller; c.stats.critChance = 1; c.selectTarget(window.__e2e.dummies[0]); })()`, 'basicAttack', [0.05, 0.15]);
+  await onCall('q', `window.controller.castAbility('Q', ${T0})`, 'qCast', [0.04, 0.12, 0.25, 0.45]);
+  await onCall('qmiss', `window.controller.castAbility('Q', new window.__e2e.THREE.Vector3(5, 0, 2))`, 'qCast', [0.12, 0.4]);
+  await onCall('emp', `(() => { const c = window.controller; c.castAbility('Q', ${T0}); setTimeout(() => { window.__fxCalls = []; c.selectTarget(window.__e2e.dummies[0]); }, 900); })()`, 'basicAttack', [0.04, 0.12, 0.25], 'basicAttack');
+  await onCall('w', `(() => { const c = window.controller; c.castAbility('W'); })()`, 'wStart', [0.3, 1.0, 2.0]);
+  await onCall('e', `window.controller.castAbility('E', ${T0})`, 'eDash', [0.08, 0.3, 0.8]);
+  await onCall('r', `window.controller.castAbility('R')`, 'rStart', [0.05, 0.3, 0.7]);
+  await onCall('rEnd', `window.controller.castAbility('R')`, 'rFinal', [0.03, 0.15, 0.4], 'rFinal');
+  await page.evaluate(() => { window.__e2e.nilahFx3.timeScale = 1; });
+  await page.waitForTimeout(1500);
+  const leak = await page.evaluate(() => { const f = window.__e2e.nilahFx3; if (!f) return 'n/a'; const keyOf = (o) => { let k = null; o.traverse((x) => { if (!k && x.material && x.material.map) k = Object.keys(window.__e2e.nilahFxTex || {}).find((n) => window.__e2e.nilahFxTex[n] === x.material.map) || (x.material.map.image && x.material.map.image.src || '').split('/').pop(); }); return k; }; return f.items.map((it) => ({ life: +it.life.toFixed(2), t: +it.t.toFixed(2), kill: it.kill, tex: keyOf(it.obj), kids: it.obj.children.length })); });
+  console.log(JSON.stringify({ shots: shots.length, errors, texFail: [...new Set(texFail)], leftoverItems: leak }, null, 1));
+  await browser.close(); srv.close();
+})();
